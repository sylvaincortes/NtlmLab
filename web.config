<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- =====================================================================
       Configuration de l'application, au niveau racine.

       IMPORTANT : le handler aspNetCore est volontairement declare ici et
       NON dans un <location path="." inheritInChildApplications="false">
       comme le genere "dotnet publish" par defaut. Avec ce wrapper, le
       handler ne se propage pas aux chemins de configuration plus profonds
       declares plus bas (<location path="ntlm">, <location path="kerberos">)
       et IIS retombe sur le gestionnaire de fichiers statiques : toutes les
       requetes vers /ntlm et /kerberos renvoient alors un 404.
       ===================================================================== -->
  <system.webServer>
    <handlers>
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath=".\NtlmLab.exe"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess" />
    <!-- =================================================================
         Racine : anonyme ET authentification Windows activee.

         Les DEUX sont necessaires :
         - anonymousAuthentication="true" fait que la page de choix "/"
           s'affiche sans invite (l'anonyme l'emporte quand il est permis) ;
         - windowsAuthentication="true" est indispensable meme si aucune
           page racine ne l'utilise. AspNetCoreModuleV2 lit la configuration
           de la RACINE de l'application au demarrage pour decider s'il
           expose le token Windows au processus. Avec "false" ici, il
           n'enregistre aucun schema d'authentification et HttpContext.User
           reste vide sur /ntlm et /kerberos, alors meme qu'IIS a bien
           authentifie la requete (LOGON_USER renseigne).

         Les <location> ci-dessous desactivent l'anonyme sur leurs chemins,
         ce qui declenche le challenge, et redefinissent les providers.
         ================================================================= -->
    <security>
      <authentication>
        <anonymousAuthentication enabled="true" />
        <windowsAuthentication enabled="true" useKernelMode="true">
          <extendedProtection tokenChecking="None" />
          <providers>
            <clear />
            <add value="Negotiate" />
            <add value="NTLM" />
          </providers>
        </windowsAuthentication>
      </authentication>
    </security>
  </system.webServer>

  <!-- =====================================================================
       /ntlm : IIS n'annonce QUE "WWW-Authenticate: NTLM".
       Pas de Negotiate => aucune chance que le client parte sur Kerberos.
       Avec LmCompatibilityLevel=5 cote serveur et client, c'est du NTLMv2.

       ATTENTION : surtout PAS authPersistSingleRequest="true" ici. NTLM est
       un protocole oriente connexion dont la poignee de main se deroule en
       trois echanges sur la MEME connexion TCP. Cet attribut reinitialise
       l'authentification a la fin de chaque requete et casse la sequence :
       le client envoie son message de type 3 et trouve un contexte remis a
       zero. Resultat, une boucle de 401 sans aucun evenement cote LSA.
       Kerberos, sans etat, n'est pas affecte, d'ou l'asymetrie trompeuse.

       Pour obtenir malgre tout un evenement par rechargement, l'application
       renvoie un en-tete "Connection: close" sur ce chemin : la connexion
       TCP est fermee, donc la poignee de main complete est rejouee.
       ===================================================================== -->
  <location path="ntlm">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true"
                                 useKernelMode="true"
                                 authPersistNonNTLM="false">
            <extendedProtection tokenChecking="None" />
            <providers>
              <clear />
              <add value="NTLM" />
            </providers>
          </windowsAuthentication>
        </authentication>
      </security>
    </system.webServer>
  </location>

  <!-- =====================================================================
       /kerberos : IIS n'annonce que "Negotiate" (SPNEGO).
       Le client tente Kerberos en premier. S'il n'obtient pas de ticket de
       service, SPNEGO encapsule du NTLM : l'application le detecte et
       l'affiche, plutot que de renvoyer un 401 sans explication.

       Note : le provider "Negotiate:Kerberos" (Kerberos strict, sans repli)
       cohabite mal avec useKernelMode et renvoie souvent un 401 immediat.
       ===================================================================== -->
  <location path="kerberos">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true"
                                 useKernelMode="true"
                                 authPersistSingleRequest="true">
            <extendedProtection tokenChecking="None" />
            <providers>
              <clear />
              <add value="Negotiate" />
            </providers>
          </windowsAuthentication>
        </authentication>
      </security>
    </system.webServer>
  </location>

</configuration>
